# AI Nexus Block — environment template
#
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored. NEVER commit real keys to this file.

# --- Supabase: public, safe to expose to the browser ---------------------
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Supabase: server-only, NEVER prefix with NEXT_PUBLIC_ ---------------
# Required only by the Nexus Local Development Agent endpoints
# (/api/ide/agent/*), which authenticate with a device token instead of a
# user session and therefore cannot rely on Row Level Security.
# Without it, the IDE works but Run / Test / Build stay disabled.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- AI providers: server-only, NEVER prefix with NEXT_PUBLIC_ -----------
# The user-facing assistant is always "Nexus AI Assistant"; these are just
# the backends behind it. At least one must be set.
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
TAVILY_API_KEY=your-tavily-api-key


# Optional model overrides
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# --- GitHub integration (server-only) ------------------------------------
# Create an OAuth App: GitHub -> Settings -> Developer settings -> OAuth Apps.
# Callback URL must be <your-origin>/api/ide/github/callback
# See docs/github-integration.md for the full setup.
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# Optional: only needed when the callback cannot be derived from the request
# (e.g. behind a proxy that rewrites Host).
# GITHUB_OAUTH_REDIRECT_URI=https://your-domain.com/api/ide/github/callback

# --- Credential encryption (server-only) ---------------------------------
# Encrypts stored GitHub access tokens at rest (AES-256-GCM).
# Generate with:  openssl rand -base64 32
# Without it, GitHub connections are refused rather than stored in plaintext.
NEXUS_ENCRYPTION_KEY=your-base64-32-byte-key

# --- Nexus Local Development Agent ---------------------------------------
# Used by agent/nexus-agent.mjs on the developer's own machine.
# NEXUS_AGENT_TOKEN=paste-the-token-shown-when-pairing
# NEXUS_SERVER_URL=http://localhost:3000
# NEXUS_WORKSPACE_ROOT=./nexus-workspaces
# See agent/README.md for NEXUS_POLL_INTERVAL_MS and NEXUS_MAX_CONCURRENT.
# Those are read by the agent process on your machine, not by this server.

# --- Site URL (public) ----------------------------------------------------
# Absolute origin used to build canonical URLs in sitemap.xml and robots.txt.
# Falls back to siteConfig.url when unset, so a deployment that leaves this
# blank will advertise the wrong domain to search engines rather than fail.
# No trailing slash.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com


# --- Ollama: local development only -------------------------------
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b
