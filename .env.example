# AI Nexus Block — environment template
#
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored. NEVER commit real keys to this file.

# --- Supabase: public, safe to expose to the browser ---------------------
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Supabase: server-only, NEVER prefix with NEXT_PUBLIC_ ---------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- AI Provider Cascade (in exact fallback execution order) --------------
# The user-facing assistant is always "Nexus AI Assistant".
# At least one provider key below must be configured.
GROQ_API_KEY=your-groq-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
GEMINI_API_KEY=your-gemini-api-key
MISTRAL_API_KEY=your-mistral-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
GITHUB_TOKEN=your-github-token-for-models
CLOUDFLARE_AI_API_KEY=your-cloudflare-ai-api-key
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
COHERE_API_KEY=your-cohere-api-key
HF_TOKEN=your-huggingface-token

# Web search provider
TAVILY_API_KEY=your-tavily-api-key

# --- GitHub integration (server-only) ------------------------------------
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# --- Credential encryption (server-only) ---------------------------------
NEXUS_ENCRYPTION_KEY=your-base64-32-byte-key
